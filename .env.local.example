# Copy this to .env.local and fill in your real IDs before deploying

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (numeric, e.g. 1234567890123456)
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Google Ads Conversion ID (format: AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
